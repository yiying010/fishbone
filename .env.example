# Copy to .env and fill in. docker-compose.yml reads this file.
# Every variable the service understands is listed here; see docs/deployment.md
# for what each one does and which are required.

# --- database (compose only; the app itself reads DATABASE_URL) --------------
POSTGRES_USER=fishbone
# These three are interpolated into a URL, so avoid : / ? # @ [ ] and space, or
# percent-encode them. An unencoded @ makes the driver parse the wrong host and
# the failure looks like an unrelated connection error rather than a bad
# password. Letters, digits, - and _ are always safe.
POSTGRES_PASSWORD=change-me-before-deploying
POSTGRES_DB=fishbone

# --- required by the app -----------------------------------------------------
# Composed from the three variables above when running under docker compose.
# DATABASE_URL=postgres://fishbone:change-me-before-deploying@db:5432/fishbone

# How long a room's data is kept after its last activity, in days. Required:
# the service refuses to start without it, so that nobody inherits a retention
# period they did not choose. Deleting is a real DELETE, not a flag.
# 3650 = 10 years.
DATA_RETENTION_DAYS=3650

# --- optional ----------------------------------------------------------------
# Host port the container is published on (loopback only).
APP_PORT=3000

# How often the retention sweep runs. Default 60.
RETENTION_SWEEP_INTERVAL_MINUTES=60

# Safety valve against a mistyped retention period. A sweep that would delete
# more than RETENTION_BULK_DELETE_PERCENT of all rooms, and at least
# RETENTION_BULK_DELETE_MINIMUM of them, refuses to run and logs a warning
# instead. Deletion is irreversible and a sweep runs at startup, so changing
# 3650 to 365 by accident would otherwise remove nine years of rooms within
# seconds of the next restart.
# Set RETENTION_CONFIRM_BULK_DELETE=true for one run when the large delete is
# genuinely intended, then set it back.
RETENTION_BULK_DELETE_PERCENT=25
RETENTION_BULK_DELETE_MINIMUM=10
RETENTION_CONFIRM_BULK_DELETE=false

# How long the server holds a sync request open before answering "no change".
# Must stay below the smallest proxy_read_timeout in front of it. Default 20000.
# Set to 0 to disable holding; clients then fall back to plain polling roughly
# every 2.5 seconds, which costs one full snapshot read per client per interval.
SYNC_LONG_POLL_MS=20000

# Apply pending migrations when the app process starts. The application default
# is true, but docker-compose.yml sets it to false because the dedicated
# `migrate` service has already run by the time `app` starts. Leave it alone
# unless you have removed that service.
MIGRATE_ON_START=false

# fatal | error | warn | info | debug | trace. Default info.
LOG_LEVEL=info

# Enables GET /api/admin/rooms/:code/export and DELETE /api/admin/rooms/:code.
# Leave empty and those routes are not registered at all. Minimum 24 characters.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=

# Read client addresses from X-Forwarded-For. Default true; correct here because
# the only way in is through nginx. The rate limits below key on that address,
# so getting this wrong would put every client in one bucket.
TRUST_PROXY=true

# --- room codes and sessions -------------------------------------------------
# Length of newly generated room codes, in Crockford Base32 characters. Default
# 10, which is 50 bits. Shorter codes are the thing this replaced: a code
# somebody chose, like a class name, is a handful of guesses wide, and a room
# holds what students wrote about their own lives.
#
# Changing this affects only newly created rooms; codes already issued at
# another length between 8 and 24 keep working. Rooms coded by hand before
# server-issued codes existed can no longer be joined at all, whatever this is
# set to. They can still be exported or deleted through the admin routes.
ROOM_CODE_LENGTH=10

# How long a member's session token stays valid, refreshed on every request.
# Default 24. A student whose session lapses re-joins automatically as long as
# their browser still holds the room code.
SESSION_TTL_HOURS=24

# --- rate limiting -----------------------------------------------------------
# All limits are per client address. A whole class shares one school NAT
# address, so the successful-traffic limit has to stay generous; what is limited
# tightly is failed room lookups, which is what enumeration looks like and what
# ordinary use produces almost none of.
RATE_LIMIT_ENABLED=true

# Failed room lookups per address per minute. Ordinary use spends this only on
# typos. While it is empty, new joins from that address are refused for up to a
# minute; members already in a room are unaffected, because a request carrying a
# valid session never consults this budget.
RATE_LIMIT_LOOKUP_FAILURES_PER_MINUTE=60

# Room creations per address per hour. Creating a room needs no credential, so
# this is what bounds someone filling the database with empty rooms.
RATE_LIMIT_ROOM_CREATES_PER_HOUR=60

# Everything under /api per address per minute. Exists to bound a single source,
# not to shape normal traffic: a class of 40 sits at a few hundred per minute.
# Raise it if a very large site shares one address.
RATE_LIMIT_REQUESTS_PER_MINUTE=3000

# --- optional AI assistance --------------------------------------------------
# Keep false until the research/privacy review and a separate deployment
# approval are complete. A real key belongs only in the untracked .env file.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_TIMEOUT_MS=30000
AI_MAX_INPUT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=500
# Per authenticated room member, in addition to the overall IP limiter above.
AI_REQUESTS_PER_MEMBER_PER_MINUTE=10

# --- rarely changed ----------------------------------------------------------
# HOST=0.0.0.0
# PORT=3000
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT_MS=10000
# MAX_SNAPSHOT_BYTES=1048576
# BODY_LIMIT_BYTES=4194304
# MAX_ARTIFACT_BYTES=4194304
# PUBLIC_DIR=/app/public
