# Copy to .env and fill in. docker-compose.yml reads this file.
# Every variable the service understands is listed here; see docs/deployment.md
# for what each one does and which are required.

# --- database (compose only; the app itself reads DATABASE_URL) --------------
POSTGRES_USER=fishbone
POSTGRES_PASSWORD=change-me-before-deploying
POSTGRES_DB=fishbone

# --- required by the app -----------------------------------------------------
# Composed from the three variables above when running under docker compose.
# DATABASE_URL=postgres://fishbone:change-me-before-deploying@db:5432/fishbone

# How long a room's data is kept after its last activity, in days. Required:
# the service refuses to start without it, so that nobody inherits a retention
# period they did not choose. Deleting is a real DELETE, not a flag.
# 3650 = 10 years.
DATA_RETENTION_DAYS=3650

# --- optional ----------------------------------------------------------------
# Host port the container is published on (loopback only).
APP_PORT=3000

# How often the retention sweep runs. Default 60.
RETENTION_SWEEP_INTERVAL_MINUTES=60

# How long the server holds a sync request open before answering "no change".
# Must stay below the smallest proxy_read_timeout in front of it. Default 20000.
# Set to 0 to disable holding; clients then fall back to plain repeated polling.
SYNC_LONG_POLL_MS=20000

# Apply pending migrations on startup. Default true.
MIGRATE_ON_START=true

# fatal | error | warn | info | debug | trace. Default info.
LOG_LEVEL=info

# Enables GET /api/admin/rooms/:code/export and DELETE /api/admin/rooms/:code.
# Leave empty and those routes are not registered at all. Minimum 24 characters.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=

# Read client addresses from X-Forwarded-For. Default true; correct here because
# the only way in is through nginx.
TRUST_PROXY=true

# --- rarely changed ----------------------------------------------------------
# HOST=0.0.0.0
# PORT=3000
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT_MS=10000
# MAX_SNAPSHOT_BYTES=1048576
# BODY_LIMIT_BYTES=4194304
# MAX_ARTIFACT_BYTES=4194304
# ROOM_CODE_MAX_LENGTH=64
# PUBLIC_DIR=/app/public
