{
  "name": "fishbone-room-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --watch server/src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node build/index.js",
    "migrate": "node server/src/cli/migrate.ts",
    "migrate:built": "node build/cli/migrate.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 server/test/*.test.mjs"
  },
  "dependencies": {
    "@fastify/static": "8.2.0",
    "fastify": "5.6.1",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/pg": "8.15.5",
    "typescript": "5.9.3"
  }
}
